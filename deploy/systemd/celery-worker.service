[Unit]
Description=Music Game Video Helper Celery Worker
After=network.target redis.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/music-game-video-helper/backend
Environment="PATH=/opt/miniconda3/bin:/usr/bin:/usr/local/bin"
ExecStart=/opt/miniconda3/bin/celery -A task worker --loglevel=info
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
